// Release.xcconfig
// Base configuration for Release builds
// This file is tracked by git

// Release builds should NOT include Local.xcconfig
// to ensure consistent production builds

// Production settings (DO NOT override these locally)
#include "Updates.xcconfig"
PRODUCT_BUNDLE_IDENTIFIER = com.app.george.quotioplus
// 直接生成 QuotioPlus.app，归档、签名和封装均使用 Target 对应的原生名称。
PRODUCT_NAME = $(TARGET_NAME)
INFOPLIST_KEY_CFBundleDisplayName = QuotioPlus
ENABLE_HARDENED_RUNTIME = YES
POSTHOG_PROJECT_TOKEN =
POSTHOG_HOST = https:/$()/us.i.posthog.com
