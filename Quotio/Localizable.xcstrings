    "usage.pricing.editHelp" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a decimal point, for example 0.25. Input and output rates are required. Blank cache rates mean unconfigured; an explicit 0 means free. Prices match the recorded model name."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用小数点输入，例如 0.25。输入和输出单价必填；缓存单价留空表示未配置，填写 0 才表示免费。按记录中的模型名称匹配价格。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用小數點輸入，例如 0.25。輸入和輸出單價必填；快取單價留空表示未設定，填寫 0 才表示免費。按記錄中的模型名稱匹配價格。"
          }
        }
      }
    },
    "usage.pricing.estimated" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimated Cost"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "估算费用"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "估算費用"
          }
        }
      }
    },
    "usage.pricing.formula" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cost = non-cached input × input rate + output × output rate + cache read × read rate + cache write × write rate, divided by 1,000,000. Reasoning is not added twice."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "费用 =（非缓存输入 × 输入单价 + 输出 × 输出单价 + 缓存读取 × 读取单价 + 缓存写入 × 写入单价）÷ 1,000,000；推理 Tokens 不重复计费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "費用 =（非快取輸入 × 輸入單價 + 輸出 × 輸出單價 + 快取讀取 × 讀取單價 + 快取寫入 × 寫入單價）÷ 1,000,000；推理 Tokens 不重複計費。"
          }
        }
      }
    },
    "usage.pricing.historyNotice" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ historical requests are included. Configure model prices to estimate the known token components; unknown cache details remain unpriced."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已纳入 %@ 次历史请求。设置模型单价后可估算已知 Token 分量；未知缓存拆分仍保留为未计价。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已納入 %@ 次歷史請求。設定模型單價後可估算已知 Token 分量；未知快取拆分仍保留為未計價。"
          }
        }
      }
    },
    "usage.pricing.historyRow" : {
