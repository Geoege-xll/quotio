      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tokens come from Claude Code, Codex, OpenCode and Pi local usage records. Cached input is included in input; reasoning is included in output. CPA usage is shown separately on the dashboard and is never added here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tokens proviennent des journaux locaux de Claude Code, Codex, OpenCode et Pi. L’entrée inclut le cache, la sortie inclut le raisonnement. Les statistiques CPA restent séparées dans le tableau de bord."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token lấy từ bản ghi cục bộ Claude Code, Codex, OpenCode và Pi. Đầu vào gồm cache, đầu ra gồm suy luận. Thống kê CPA được hiển thị riêng trên bảng điều khiển."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token 来自 Claude Code、Codex、OpenCode 和 Pi 的本地用量记录。输入包含缓存，输出包含推理；CPA 用量在仪表盘独立展示，不计入本页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Token 來自 Claude Code、Codex、OpenCode 和 Pi 的本機用量記錄。輸入包含快取，輸出包含推理；CPA 用量在儀表盤獨立顯示，不計入本頁。"
          }
        }
      }
