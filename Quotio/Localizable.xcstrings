      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This CPA version does not provide supported request events. Previously saved records remain available; no events are fabricated from process totals."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前 CPA 版本未提供支持的请求事件。已有明细仍可查看，不会根据进程累计值虚构请求记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前 CPA 版本未提供支援的請求事件。已有明細仍可檢視，不會根據程序累計值虛構請求記錄。"
          }
        }
      }
    },
    "usage.records.metricRules" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Success rate excludes cancellations. RPM/TPM are averages over the selected interval (minimum one minute); All uses the first-to-last event span. TPS uses successful generation samples with valid TTFT: output tokens / (latency − TTFT). Latency and TTFT averages include only reported samples; incomplete cache breakdowns are left blank. No prices or costs are inferred."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功率排除取消请求。RPM/TPM 为所选时间窗口的平均值，窗口最少按一分钟计算；全部记录使用首末事件跨度。TPS 仅使用有有效 TTFT 的成功生成样本，按输出 Token ÷（总延迟－TTFT）计算。延迟均值仅纳入已报告样本，缓存明细不完整时留空，不推测价格或费用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "成功率排除取消請求。RPM/TPM 為所選時間視窗的平均值，視窗最少按一分鐘計算；全部記錄使用首末事件跨度。TPS 僅使用有有效 TTFT 的成功生成樣本，按輸出 Token ÷（總延遲－TTFT）計算。延遲均值僅納入已回報樣本，快取明細不完整時留空，不推測價格或費用。"
          }
        }
      }
    },
