    "storage.cache.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clears rebuildable memory and network caches while keeping analytics history and scan progress. Deleted rows leave database pages available for reuse. Reclaiming free space can shrink the file and may take time for large databases."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清理可重建的内存与网络缓存，保留统计历史和扫描进度。删除统计后，数据库空闲页会留给后续写入；回收空闲空间可尝试缩小文件，数据较多时需要等待。"
          }
        }
      }
    },
    "storage.cache.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
