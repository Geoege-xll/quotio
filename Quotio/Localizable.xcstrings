    "usage.pi.coverage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pi totals include saved sessions and saved child sessions. Extension transcripts are excluded to avoid double counting; usage recorded only in those transcripts is not included."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les totaux Pi incluent les sessions et sous-sessions enregistrées. Les transcriptions d’extensions sont exclues pour éviter les doublons ; l’utilisation conservée uniquement dans ces transcriptions n’est pas comptabilisée."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tổng Pi bao gồm các phiên và phiên con đã lưu. Bản ghi của tiện ích mở rộng không được cộng để tránh tính trùng; mức sử dụng chỉ có trong các bản ghi đó chưa được thống kê."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pi 统计已保存的正式会话及子会话。扩展转录可能与正式会话重复，因此不合并；仅保存在扩展转录中的用量未纳入统计。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pi 統計已儲存的正式工作階段及子工作階段。擴充套件轉錄可能與正式工作階段重複，因此不合併；僅儲存於擴充套件轉錄的用量未納入統計。"
          }
        }
      }
    },
    "usage.pi.reasoningUnavailable" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some Pi records do not report reasoning tokens. The reasoning subtotal is unavailable; reported tokens remain included in output and total tokens."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分 Pi 记录未报告思考 Token 明细，因此不显示思考小计；已报告的消耗仍计入输出和总 Token。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分 Pi 記錄未回報思考 Token 明細，因此不顯示思考小計；已回報的消耗仍計入輸出和總 Token。"
          }
        }
      }
    },
