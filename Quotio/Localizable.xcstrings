    "remote.sslWarning.message" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disabling SSL verification allows attackers to intercept your management key and all remote operations (Man-in-the-Middle attack).\\n\\nOnly disable this for development environments or when you fully trust the network."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactiver la vérification SSL permet aux attaquants d'intercepter votre clé de gestion et toutes les opérations distantes (attaque de l'homme du milieu).\\n\\nNe désactivez cette option que pour les environnements de développement ou lorsque vous faites entièrement confiance au réseau."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tắt xác minh SSL cho phép kẻ tấn công chặn management key và tất cả các thao tác từ xa (tấn công Man-in-the-Middle).\\n\\nChỉ tắt tùy chọn này cho môi trường phát triển hoặc khi bạn hoàn toàn tin tưởng mạng hiện tại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "禁用SSL验证会让攻击者拦截您的管理密钥和所有远程操作（中间人攻击）。\\n\\n仅在开发环境或完全信任网络时才禁用此选项。"
          }
        }
      }
    },
