    "usage.retentionNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistics use the local CPA usage ledger. Cached and reasoning tokens may overlap input/output tokens and are not added again. Expired or previously consumed queue history cannot be recovered."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Statistiques issues du registre CPA local. Les tokens en cache et de raisonnement ne sont pas ajoutés une seconde fois. Les événements expirés ou déjà consommés ne sont pas récupérables."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thống kê từ sổ sử dụng CPA cục bộ. Token bộ nhớ đệm và suy luận không được cộng trùng vào tổng. Không thể khôi phục lịch sử hàng đợi đã hết hạn hoặc đã được đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "统计来自本机 CPA 用量账本。缓存、推理 Token 可能属于输入／输出的子集，不重复计入总量。已经过期或被消费的队列历史无法补回。"
          }
        }
      }
    },
