    "usage.replica.filterHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select the client that recorded usage: Claude Code, Codex or OpenCode. The period controls totals, trends and model details; heatmaps show the last 52 weeks. All values are tokens, without adding CPA gateway records again."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filtrez selon le client : Claude Code, Codex ou OpenCode. La période contrôle les totaux, tendances et détails ; les cartes couvrent 52 semaines. Valeurs en tokens, sans ajouter à nouveau les enregistrements CPA."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lọc theo ứng dụng ghi mức sử dụng: Claude Code, Codex hoặc OpenCode. Khoảng thời gian áp dụng cho tổng, xu hướng và chi tiết; bản đồ nhiệt hiển thị 52 tuần. Chỉ tính token, không cộng lại bản ghi CPA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按记录用量的客户端筛选：Claude Code、Codex 或 OpenCode。时间范围控制摘要、趋势和模型明细；热力图显示最近 52 周。全页仅统计 Token，不再叠加 CPA 网关记录。"
          }
        }
      }
    },
