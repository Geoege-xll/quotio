    "usage.dashboard.historyIncluded" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes %@ requests from daily history. Trends use daily totals; request details and pricing only cover retained events. Historical cancellations, cache splits and generation metrics cannot be recovered."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已纳入日归档中的 %@ 次请求，趋势按天展示；请求明细与价格统计仅覆盖已保存事件。历史取消数、缓存拆分和生成指标无法补回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已納入日歸檔中的 %@ 次請求，趨勢按天展示；請求明細與價格統計僅涵蓋已儲存事件。歷史取消數、快取拆分和生成指標無法補回。"
          }
        }
      }
    },
    "usage.dashboard.historyIncomplete" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some daily history cannot be resolved with these exact time or metadata filters. Values cover the known subset; ≥ marks a lower bound and — means unavailable. Choose All with model/provider filters to include daily history."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分日归档无法按当前精确时间或其他条件筛选，当前仅展示可确认部分；≥ 表示下界，— 表示无法确定。选择“全部”时间并仅按模型或提供商筛选，可完整纳入日归档。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分日歸檔無法依目前精確時間或其他條件篩選，目前僅展示可確認部分；≥ 表示下界，— 表示無法確定。選擇「全部」時間並僅依模型或提供商篩選，可完整納入日歸檔。"
          }
        }
      }
    },
