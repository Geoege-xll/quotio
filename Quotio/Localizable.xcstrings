    "agents.defaultModel.codexInfo" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save the model ID or proxy alias Codex CLI uses at startup. Codex's /model menu uses its own catalog; saving here does not add proxy models to that menu. Saved selections are kept when absent from the refreshed list."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez l’ID du modèle ou l’alias du proxy utilisé au démarrage de Codex CLI. Son menu /model utilise son propre catalogue ; cet enregistrement n’y ajoute pas les modèles du proxy. Les choix enregistrés sont conservés même s’ils sont absents de la liste actualisée."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu ID mô hình hoặc bí danh proxy dùng khi Codex CLI khởi động. Menu /model của Codex dùng danh mục riêng; lưu tại đây không thêm mô hình proxy vào menu đó. Lựa chọn đã lưu vẫn được giữ khi không có trong danh sách làm mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存 Codex CLI 启动时使用的模型 ID 或代理别名。Codex 的 /model 菜单使用独立目录，此处保存不会把代理模型加入该菜单。已保存的选择会保留，即使刷新后的列表中暂时没有它。"
