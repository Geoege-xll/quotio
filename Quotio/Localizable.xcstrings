    "usage.cpa.coverage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The dashboard preserves the collected CPA daily history. Cached tokens combine reads and writes. Open Usage Records for account/key/result filters, cancellations, TTFT and generation speed on newly collected requests. Missing historical details and costs are not reconstructed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仪表盘保留已采集的 CPA 日汇总，缓存 Token 合并读取与创建。账号、密钥、结果筛选，以及取消、首 Token 延迟和生成速度请进入“使用记录”查看新增明细；历史缺失数据和费用不进行推测。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "儀表盤保留已收集的 CPA 每日彙總，快取 Token 合併讀取與建立。帳號、金鑰、結果篩選，以及取消、首 Token 延遲和生成速度請進入「使用記錄」檢視新增明細；歷史缺失資料和費用不進行推測。"
          }
