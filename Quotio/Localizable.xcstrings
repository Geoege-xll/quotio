        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applying proxy mode installs the official CLIProxyAPI provider if needed. Default mode disables its registration and managed model selection, preserving other settings. Restart Pi after applying."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用代理模式时会按需安装官方 CLIProxyAPI 插件；默认模式停用插件注册及对应默认模型，保留其他设置。应用后请重启 Pi。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "套用代理模式時會按需安裝官方 CLIProxyAPI 外掛；預設模式停用外掛註冊及對應預設模型，保留其他設定。套用後請重新啟動 Pi。"
          }
        }
      }
    },
    "agents.pi.statusHelp" : {
      "comment" : "区分 Pi 可执行文件安装状态与 Quotio/CPA 代理配置状态。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installed means the Pi executable was found. Configured means Pi is connected to CPA through Quotio. Signing in to another provider does not change this status."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installé signifie que l’exécutable Pi a été détecté. Configuré signifie que Pi est connecté à CPA via Quotio. La connexion à un autre fournisseur ne change pas cet état."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã cài đặt nghĩa là đã tìm thấy tệp thực thi Pi. Đã cấu hình nghĩa là Pi đã kết nối với CPA qua Quotio. Đăng nhập vào nhà cung cấp khác không thay đổi trạng thái này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装表示已找到 Pi 可执行文件；已配置表示已通过 Quotio 接入 CPA。Pi 登录其他提供商不会改变此接入状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安裝表示已找到 Pi 執行檔；已設定表示已透過 Quotio 接入 CPA。Pi 登入其他供應商不會改變此接入狀態。"
          }
        }
      }
