    "agents.modelMapping.defaultOneMillionInfo" : {
      "comment" : "默认模型合并到模型用途表格：区分独立设置与角色继承。",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A specific model has its own 1M setting. A linked role inherits that role’s setting. Disabling an explicit role[1m] selection returns to the role’s setting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un modèle précis a son propre réglage 1M. Un rôle lié hérite du sien. Désactiver un choix explicite rôle[1m] rétablit le réglage du rôle."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mô hình cụ thể có tùy chọn 1M riêng. Khi theo vai trò, tùy chọn được kế thừa. Tắt lựa chọn vai trò[1m] sẽ trở về tùy chọn của vai trò."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定模型时独立设置 1M；跟随角色时继承该角色的设置。关闭显式角色[1m]选择后，恢复跟随该角色。"
          }
        }
      }
    },
