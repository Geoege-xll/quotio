    "usage.pricing.notice" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard-rate estimates from manually configured model prices, not invoices. Subscription, long-context and service-tier adjustments are not applied. Unpriced or incomplete requests are excluded; coverage is shown separately."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按手动配置的模型标准单价估算，不是实际账单；不包含订阅、长上下文和服务等级调整。未配置价格或字段不完整的请求不计入费用，覆盖率单独展示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按手動設定的模型標準單價估算，不是實際帳單；不包含訂閱、長上下文和服務等級調整。未設定價格或欄位不完整的請求不計入費用，覆蓋率單獨顯示。"
          }
        }
