    "callAnalytics.pi.coverage" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pi counts tool calls in saved sessions and child sessions. Extension transcripts are not merged; calls recorded only in those transcripts are excluded. Reading SKILL.md indicates possible skill use. MCP classification requires an explicit server/tool name; tool durations are not inferred."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pi compte les appels d’outils des sessions et sous-sessions enregistrées. Les transcriptions d’extensions ne sont pas fusionnées ; les appels qui y figurent seuls sont exclus. La lecture de SKILL.md signale un usage possible d’une compétence. MCP exige un nom explicite de serveur et d’outil ; aucune durée n’est déduite."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pi thống kê lệnh gọi công cụ trong các phiên và phiên con đã lưu. Bản ghi của tiện ích mở rộng không được hợp nhất; lệnh gọi chỉ có trong các bản ghi đó chưa được thống kê. Việc đọc SKILL.md là dấu hiệu sử dụng kỹ năng. MCP được phân loại theo tên máy chủ/công cụ rõ ràng; không suy đoán thời gian thực thi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pi 统计已保存的正式会话及子会话中的工具调用，不合并扩展转录；仅保存在转录中的调用未纳入统计。读取 SKILL.md 作为技能使用信号；MCP 按明确的服务器／工具命名归类，不推测工具耗时。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pi 統計已儲存的正式工作階段及子工作階段中的工具呼叫，不合併擴充套件轉錄；僅儲存於轉錄的呼叫未納入統計。讀取 SKILL.md 作為技能使用訊號；MCP 按明確的伺服器／工具命名歸類，不推測工具耗時。"
          }
        }
      }
    },
    "callAnalytics.privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read-only local analysis. Only daily counts and tool names are saved; conversations, arguments and credentials are not archived."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyse locale en lecture seule. Seuls les comptes quotidiens et noms d’outils sont conservés, sans conversations, paramètres ni identifiants."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phân tích cục bộ chỉ đọc. Chỉ lưu số lượt hằng ngày và tên công cụ; không lưu hội thoại, tham số hay thông tin xác thực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在本地只读分析，只保存每日计数和工具名称，不归档对话、执行参数或凭据。"
          }
        }
      }
    },
