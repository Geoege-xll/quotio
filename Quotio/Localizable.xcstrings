    "settings.yubikey.help" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses an RSA PIV identity on your YubiKey. Quotio stores encrypted ciphertext locally; the private key and PIN stay on the YubiKey. Set up a key below if none is listed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise une identité PIV RSA sur votre YubiKey. Quotio stocke localement du texte chiffré ; la clé privée et le code PIN restent sur la YubiKey. Configurez une clé ci-dessous si aucune n’apparaît."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sử dụng danh tính PIV RSA trên YubiKey của bạn. Quotio lưu bản mã hóa trên máy; khóa riêng và mã PIN luôn nằm trong YubiKey. Hãy thiết lập một khóa bên dưới nếu chưa có khóa nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 YubiKey 上的 RSA PIV 身份。Quotio 在本地保存加密后的密文；私钥和 PIN 始终留在 YubiKey 上。如果下方没有列出密钥，请先设置一个。"
          }
        }
      }
